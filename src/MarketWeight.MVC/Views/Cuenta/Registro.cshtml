@{
    ViewData["Title"] = "Registro";
}

<div class="container">
    <h1 class="title">Registro de Usuario</h1>

    <form method="post" action="/Cuenta/Registro" class="form">
        <div class="form-group">
            <label for="nombre" class="label">Nombre</label>
            <input type="text" id="nombre" name="nombre" required class="input" placeholder="Ingrese su nombre" />
        </div>
        <div class="form-group">
            <label for="apellido" class="label">Apellido</label>
            <input type="text" id="apellido" name="apellido" required class="input" placeholder="Ingrese su apellido" />
        </div>
        <div class="form-group">
            <label for="email" class="label">Email</label>
            <input type="email" id="email" name="email" required class="input" placeholder="ejemplo@correo.com" />
        </div>
        <div class="form-group">
            <label for="pass" class="label">Contraseña</label>
            <input type="password" id="pass" name="pass" required class="input" placeholder="Ingrese su contraseña" />
        </div>
        <div class="form-group">
            <label for="confirmPass" class="label">Confirmar Contraseña</label>
            <input type="password" id="confirmPass" name="confirmPass" required class="input" placeholder="Confirme su contraseña" />
        </div>
        <button type="submit" class="btn">Registrarse</button>
    </form>
</div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }