@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="compra-container">
    <h1>Iniciar Sesión</h1>
    <form asp-action="Login" method="post" class="form-compra">
        <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required class="form-control" placeholder="ejemplo@correo.com" />
        </div>
        <div class="form-group">
            <label for="password">Contraseña</label>
            <input type="password" id="password" name="password" required class="form-control" placeholder="Ingrese su contraseña" />
        </div>
        <button type="submit" class="btn-compra">Iniciar Sesión</button>
    </form>
</div>