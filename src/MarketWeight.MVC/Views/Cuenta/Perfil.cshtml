@using MarketWeight.Core
@using MarketWeight.MVC.ViewModels.Cuenta
@model IEnumerable<MarketWeight.Core.Moneda>

@{
    ViewData["Title"] = "Perfil de Usuario";
}

<div class="container" style="width: 100vw;">
    <h1 class="title">Perfil de Usuario</h1>

    <div class="form-group" style="margin-bottom: 30px;" style="width: 100%">
        <h2>Bienvenido/a, @LoginViewModel.CurrentUser?.Nombre @LoginViewModel.CurrentUser?.Apellido</h2>
        <p><strong>Saldo:</strong> $@LoginViewModel.CurrentUser?.Saldo.ToString("N2")</p>
    </div>

    <div class="form-group" style="margin-bottom: 50px;" style="width: 100%">
        <h3>Ingresar monto</h3>
        <form method="post" action="/Usuarios/Deposito" class="form">
            <input type="hidden" name="idUsuario" value="@LoginViewModel.CurrentUser?.IdUsuario" />
            <div class="form-group">
                <label for="monto" class="label">Monto</label>
                <input type="text" id="monto" name="monto" required class="input" placeholder="Ingrese el monto"
                    style="max-width: 300px;" />
            </div>
            <button type="submit" class="btn">Ingresar</button>

            @{
                var successMessage = TempData["SuccessMessage"] as string;
                var errorMessage = TempData["ErrorMessage"] as string;
                var message = successMessage ?? errorMessage;
                var alertClass = successMessage != null ? "alert-success" : "alert-danger";
            }
            @if (message != null)
            {
                <div class="alert @alertClass">
                    @message
                </div>
            }
        </form>
    </div>

    <div>
        <h1 class="title">Tabla de Criptos</h1>
        <table class="datos">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Precio</th>
                    <th>Cantidad</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Moneda moneda in LoginViewModel.Criptos)
                {
                    <tr>
                        <td>@moneda.Nombre</td>
                        <td>@moneda.Precio.ToString("N2")</td>
                        <td>@moneda.Cantidad.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>